# Copy to .env.production. Do not put secrets in this file.
COMPOSE_PROJECT_NAME=chathelper
CHAT_DOMAIN=chat.tallweb.net
ACME_EMAIL=admin@tallweb.net

# Version-pinned production images. Review release notes before changing them.
CADDY_IMAGE=caddy:2.11.4-alpine
POSTGRES_IMAGE=postgres:17.11-alpine3.24
QDRANT_IMAGE=qdrant/qdrant:v1.19.0
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda12-b10884
APP_IMAGE_TAG=local

# Absolute host directory containing both GGUF model files.
MODELS_DIR=/srv/chathelper/models
CHAT_MODEL_FILE=Qwen3-14B-Instruct-Q4_K_M.gguf
EMBED_MODEL_FILE=bge-m3-Q8_0.gguf

# Parallel application requests and model generations are separate limits.
APP_WORKERS=2
LLM_SLOTS=2
LLM_CTX=8192
LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

POSTGRES_DB=chathelper
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_POOL_TIMEOUT=10

QDRANT_COLLECTION=tallweb
EMBED_DIM=1024
EMBED_DOC_PREFIX=
EMBED_QUERY_PREFIX=
TOP_K=6

SITE_NAME=Tallweb
SITE_NAMES=
SITE_STYLES=
ALLOWED_ORIGINS=https://tallweb.net,https://www.tallweb.net

FREQUENCY_PENALTY=0.4
PRESENCE_PENALTY=0.4
MAX_TOKENS=500
PAGE_MAX_CHARS=1500
QUERY_REWRITE=1
CHAT_MAX_MESSAGE_CHARS=4000
CHAT_HISTORY_MAX_ITEMS=12
CHAT_RATE_LIMIT_PER_MINUTE=30
QA_LOGIN_RATE_LIMIT_PER_MINUTE=10

CRAWL_MAX_PAGES=200
CRAWL_SAME_DOMAIN=1
CRAWL_PDFS=1
CRAWL_PDF_MAX_MB=20
BOILERPLATE_STRIP=1
BOILERPLATE_MIN_PAGES=4
BOILERPLATE_PAGE_FRACTION=0.3
