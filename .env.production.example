# Copy to .env.production. Do not put secrets in this file: the chat API key
# goes into secrets/llm_api_key.txt (created empty by `deploy.sh prepare`).
COMPOSE_PROJECT_NAME=chathelper
CHAT_DOMAIN=chat.tallweb.net
ACME_EMAIL=admin@tallweb.net

# Which model containers run (comma-separated Compose profiles):
#   local-embed            (default) embeddings from a CPU llama.cpp container
#                          running bge-m3. No GPU; existing collections keep
#                          working.
#   local-embed,local-llm  additionally chat from a GPU llama.cpp container
#                          (NVIDIA driver + Container Toolkit on the host).
#   (empty)                chat AND embeddings from the hosted API. Switch the
#                          EMBED_* block below and re-ingest every site: the
#                          vector dimension changes.
COMPOSE_PROFILES=local-embed

# --- Chat model: hosted OpenAI API (default) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_EXTRA_BODY={}
LLM_TIMEOUT=120
# For the local-llm profile use instead:
#   LLM_BASE_URL=http://llm:8080/v1
#   LLM_MODEL=local-chat
#   LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
#   CHAT_MODEL_FILE=Qwen3-14B-Instruct-Q4_K_M.gguf
#   LLM_SLOTS=2
#   LLM_CTX=8192

# --- Embeddings: bge-m3 on CPU (default, local-embed profile) ---
# Absolute host directory holding the GGUF file(s); mounted read-only.
MODELS_DIR=/srv/chathelper/models
EMBED_MODEL_FILE=bge-m3-Q8_0.gguf
EMBED_BASE_URL=http://embed:8081/v1
EMBED_MODEL=local-embed
EMBED_DIM=1024
EMBED_DOC_PREFIX=
EMBED_QUERY_PREFIX=
EMBED_TIMEOUT=60
# Hosted alternative (set COMPOSE_PROFILES= empty; requires re-ingesting):
#   EMBED_BASE_URL=https://api.openai.com/v1
#   EMBED_MODEL=text-embedding-3-small
#   EMBED_DIM=1536

# --- Images ---
# Caddy, PostgreSQL and Qdrant have version tags; review release notes before
# changing them. llama.cpp publishes rolling tags only, so after the first
# successful pull pin by digest, e.g.
#   docker image inspect --format '{{index .RepoDigests 0}}' ghcr.io/ggml-org/llama.cpp:server
# and paste the result (name@sha256:...) here.
CADDY_IMAGE=caddy:2.11.4-alpine
POSTGRES_IMAGE=postgres:17.11-alpine3.24
QDRANT_IMAGE=qdrant/qdrant:v1.19.0
LLAMA_CPU_IMAGE=ghcr.io/ggml-org/llama.cpp:server
LLAMA_CUDA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
APP_IMAGE_TAG=local

# Parallel HTTP workers. With the hosted chat API, generation concurrency is
# bounded by your OpenAI rate limits; with local-llm it is LLM_SLOTS.
APP_WORKERS=2

POSTGRES_DB=chathelper
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_POOL_TIMEOUT=10

QDRANT_COLLECTION=tallweb
TOP_K=6

SITE_NAME=Tallweb
SITE_NAMES=
SITE_STYLES=
ALLOWED_ORIGINS=https://tallweb.net,https://www.tallweb.net

FREQUENCY_PENALTY=0.4
PRESENCE_PENALTY=0.4
MAX_TOKENS=500
PAGE_MAX_CHARS=1500
QUERY_REWRITE=1
CHAT_MAX_MESSAGE_CHARS=4000
CHAT_HISTORY_MAX_ITEMS=12
CHAT_RATE_LIMIT_PER_MINUTE=30
QA_LOGIN_RATE_LIMIT_PER_MINUTE=10

CRAWL_MAX_PAGES=200
CRAWL_SAME_DOMAIN=1
CRAWL_PDFS=1
CRAWL_PDF_MAX_MB=20
CRAWL_MAX_PAGE_MB=5
BOILERPLATE_STRIP=1
BOILERPLATE_MIN_PAGES=4
BOILERPLATE_PAGE_FRACTION=0.3
